{
    // --- General Settings ---
    "python.linting.enabled": true,
    // --- Actions on Save ---
    "[python]": {
        // Use the official Black Formatter extension
        "editor.defaultFormatter": "ms-python.black-formatter",
        // This runs formatting and organizes imports automatically on every save
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "editor.formatOnSave": true,
    // --- Optional: Visual ruler for line length ---
    "editor.rulers": [
        88
    ]
}